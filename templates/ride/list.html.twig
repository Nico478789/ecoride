{% extends 'base.html.twig' %}

{% block title %}Tous mes trajets{% endblock %}

{% block body %}
<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Origine</th>
            <th scope="col">Destination</th>
            <th scope="col">Organisateur</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for ride in rides %}
        
            <tr>
                <td scope="row">{{ ride.whereFrom }}</td>
                <td scope="row">{{ ride.whereTo }}</td>
                <td scope="row">{{ ride.email }}</td>
                
                <td scope="row">
                   <a class="btn btn-primary" href="{{ path('app_ride_show', {'id': ride.id}) }}">Détail</a>
                    <a class="btn btn-primary" href="{{ path('app_ride_edit', {'id': ride.id}) }}">Modifier</a>
                    <a class="btn btn-primary" href="{{ path('app_ride_delete', {'id': ride.id}) }}">Supprimer</a>
                </td>
            </tr>
           
        {% endfor %}
    </tbody>
</table>
<a class="btn btn-primary" href="/ride/create">Ajouter un trajet</a>
{% endblock %}
