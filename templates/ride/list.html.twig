{% extends 'base.html.twig' %}

{% block title %}Tous les trajets{% endblock %}

{% block body %}

<h1 class="text-center text-white">Tous les trajets</h1>

<!-- Filter form - check SearchType.php and RideController-->
{% if formview is not defined %}
    {% set formview = form %}
{% endif %}

{%include "./_search.html.twig"%}

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Origine</th>
            <th scope="col">Destination</th>
            <th scope="col">Organisateur</th>
            <th scope="col">Départ</th>
            <th scope="col">Voiture</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for ride in rides %}
        
            <tr>
                <td scope="row">{{ ride.whereFrom }}</td>
                <td scope="row">{{ ride.whereTo }}</td>
                <td scope="row">{{ ride.nickname }}</td>
                <td scope="row">{{ ride.departure_time|date('d/m/Y H:i') }}</td>
                <td scope="row">{{ ride.brand_name }}</td>
                
                <td scope="row">
                   <a class="btn btn-primary" href="{{ path('app_ride_show', {'id': ride.id}) }}">Détail</a>
                    <a class="btn btn-primary" href="{{ path('app_ride_join', {'id': ride.id}) }}">Participer</a>
                    <a class="btn btn-danger" href="{{ path('app_ride_edit', {'id': ride.id}) }}">Modifier</a>
                    <a class="btn btn-danger" href="{{ path('app_ride_delete', {'id': ride.id}) }}">Supprimer</a>
                </td>
            </tr>
           
        {% endfor %}
    </tbody>
</table>

{% endblock %}
