{% extends 'base.html.twig' %}

{% block title %}Trajet{% endblock %}

{% block body %}

<h1 class="text-white">Création d'un trajet</h1>
{# {{ form(formview)}} #}
{{form_start(formview,{attr:{'class':'text-white p-3'}})}}
{{form_row(formview.whereFrom)}}
{{form_row(formview.whereTo)}}
{{form_row(formview.departure_time)}}
{{form_row(formview.arrival_time)}}
{{form_row(formview.price)}}
{{form_row(formview.number_of_seats)}}
{{form_row(formview.car)}}

<button type="submit" class="btn btn-primary">Enregistrer</button>
{{form_end(formview)}}

{# <a class="btn btn-primary" href="{{ path('marque_index') }}">Retour à la liste</a> #}
{% endblock %}