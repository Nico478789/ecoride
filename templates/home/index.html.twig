{% extends 'base.html.twig' %}

{% block title %}Accueil EcoRide{% endblock %}

{% block body %}
<h1 class="text-white text-center mb-3">Bienvenue sur le site EcoRide</h1>
<form class="row m-3">
    <div class="col-12 col-md-4 mb-3">
      <label for="origin" class="text-white form-label"
        >D'où partez vous ?</label
      >
      <input type="text" class="form-control" id="origin" name="origin" />
    </div>
    <div class="col-12 col-md-4 mb-3">
      <label for="destination" class="text-white form-label"
        >Où allez-vous ?</label
      >
      <input
        type="text"
        class="form-control"
        id="destination"
        name="destination"
      />
    </div>
    <div class="col-12 col-md-4 mb-3">
      <label for="trip_date" class="text-white form-label"
        >A quelle date ?</label
      >
      <input type="date" class="form-control" id="trip_date" name="trip_date" />
    </div>
    <div class="text-center">
      <button class="btn btn-primary">
        <i class="bi bi-taxi-front-fill"></i>
        Voir les covoiturages
      </button>
    </div>
  </form>

<div class="container">
    <div class="row">
        <div class="col-4 text-center">
            <img src="{{asset("./assets/Pictures/accueil1.jpeg")}}" alt= "voiture qui roule au coucher du soleil dans un environnement eco-friendly" style="width: 100%; height: auto;">
        </div>
        <div class="col-4 text-center text-white d-flex flex-column justify-content-center align-items-center">
            <h2>Ecoride : Le spécialiste de l'écovoiturage</h2>
        </div>
        <div class="col-4 text-center">
            <img src="{{asset("./assets/Pictures/accueil2.jpeg")}}" alt= "voiture qui roule au lever du soleil dans un environnement eco-friendly" style="width: 100%; height: auto;">
        </div>
    </div>



{% endblock %}
