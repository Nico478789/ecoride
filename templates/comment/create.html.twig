{% extends 'base.html.twig' %}


{% block title %}Nouveau commentaire{% endblock %}

{% block body %}

<h1 class="text-white">Créer un nouveau commentaire</h1>
{{form_start(formview,{attr:{'class':'text-white p-3'}})}}
{{form_row(formview.targetId)}}
{{form_row(formview.title)}}
{{form_row(formview.content)}}


<h1 class="text-white">Etoiles</h1>
<div class="stars">
      <i class="bi bi-star" alt="etoile" data-value="1"></i>
      <i class="bi bi-star" alt="etoile" data-value="2"></i>
      <i class="bi bi-star" alt="etoile" data-value="3"></i>
      <i class="bi bi-star" alt="etoile" data-value="4"></i>
      <i class="bi bi-star" alt="etoile" data-value="5"></i>
</div>

{# <input type="h" name="note" id="note" value="0"> #}


{{ form_row(formview.grade) }}

<button type="submit" class="btn btn-primary">Enregistrer</button>

<script src="{{ asset('js/stars.js') }}"></script>
{{form_end(formview)}}

{% endblock %}