{% extends 'base.html.twig' %}

{% block title %}Voitures{% endblock %}

{% block body %}

<h1 class="text-white">Création d'une voiture</h1>
{# {{ form(formview)}} #}
{{form_start(formview,{attr:{'class':'text-white p-3'}})}}
{{form_row(formview.brand_name)}}
{{form_row(formview.model_name)}}
{{form_row(formview.color)}}
{{form_row(formview.first_registration_date)}}
{{form_row(formview.registration_number)}}
{{form_row(formview.electric)}}

<button type="submit" class="btn btn-primary">Enregistrer</button>

{{form_end(formview)}}


{# <a class="btn btn-primary" href="{{ path('marque_index') }}">Retour à la liste</a> #}
{% endblock %}